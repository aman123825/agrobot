# Copy to pi/.env (gitignored), fill in, and `set -a; source .env; set +a`
# before launching the Pi services. Never commit the real .env.

# Shared command-link secret. MUST match the firmware COMMAND_HMAC_KEY exactly.
# Generate with: openssl rand -hex 32
AGRO_LINK_KEY=replace-with-32-plus-byte-random-secret

# MQTT broker auth
MQTT_HOST=localhost
MQTT_USERNAME=agrorover
MQTT_PASSWORD=strong-mqtt-password

# MQTT TLS (recommended). Set to 1 and point at the broker CA certificate.
MQTT_TLS=0
MQTT_CA_CERT=/etc/mosquitto/certs/ca.crt

# Serial device for the ESP32 link
ESP32_SERIAL=/dev/ttyUSB0

# Telegram alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
