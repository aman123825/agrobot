// AgriRover v2 wiring — Graphviz source (deterministic, connection-accurate).
// Render:  dot -Tpng wiring-v2.dot -o wiring-v2.png   (or -Tsvg / -Tpdf)
// Or paste into https://dreampuf.github.io/GraphvizOnline / https://edotor.net
digraph agrover_v2 {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  // ---------- POWER ----------
  subgraph cluster_pwr {
    label="POWER"; style=filled; color="#fff3e0";
    node [fillcolor="#ffe0b2"];
    lipo  [label="3S LiPo 11.1V"];
    fuse  [label="Blade Fuse 25-30A"];
    xt60  [label="Anti-Spark XT60"];
    sw    [label="Rocker Switch"];
    bus   [label="11.1V BUS", fillcolor="#ffcc80"];
    buck  [label="LM2596 -> 5.00V"];
    rail  [label="5V RAIL"];
    fer   [label="Ferrite bead"];
    pbank [label="Power Bank 5V/3A"];
    solar [label="5W Solar"]; tp [label="TP4056"];
    lipo->fuse->xt60->sw->bus [color="#e65100", penwidth=2];
    bus->buck->rail->fer [color="#e65100", penwidth=2];
    solar->tp->lipo [style=dashed, label="trickle"];
  }

  // ---------- ESP32 ----------
  esp [fillcolor="#bbdefb", label="ESP32 DevKit V1\l\l19,21->L298N#1 IN1/2\l22,23->L298N#2 IN3/4\l32,33->ENA/ENB PWM\l25->US TRIG  18->US ECHO*\l27->SG90 sweep\l17/16/4->MAX485 (NPK)\l14->DHT22\l34->Moisture(3.3V!)\l36->TDS(3.3V!)\l35->Batt divider\l39->GPS RX  15->GPS RX(DGPS)\l26->Relay pump(10k)\l13->Relay actuator(10k)\lEN->E-STOP\lVIN<-5V via ferrite\lTX0/RX0->CP2102->Pi\l"];
  fer->esp [color="#1565c0", penwidth=2, label="5V VIN"];

  cam [fillcolor="#bbdefb", label="ESP32-CAM (isolated)\n5V+GND+16GB SD"];
  rail->cam [color="#1565c0", label="5V"];

  // ---------- DRIVE / ACTUATION ----------
  subgraph cluster_drive {
    label="DRIVE / ACTUATION"; color="#fce4ec"; style=filled;
    node [fillcolor="#f8bbd0"];
    l1 [label="L298N #1 LEFT"]; l2 [label="L298N #2 RIGHT"];
    motors [label="4x Gear Motors\n+1N5819 flyback"];
    relay [label="2-ch Relay\n+10k pull-ups"];
    pumpact [label="Pump / Actuator 12V"];
  }
  esp->l1 [label="19,21,32"]; esp->l2 [label="22,23,33"];
  l1->motors; l2->motors;
  bus->l1 [color="#e65100", penwidth=2]; bus->l2 [color="#e65100", penwidth=2];
  bus->relay [color="#e65100", penwidth=2, label="COM"];
  esp->relay [label="26,13"]; relay->pumpact;

  // ---------- ESP32 SENSORS ----------
  subgraph cluster_esens {
    label="ESP32 SENSORS"; color="#f9fbe7"; style=filled;
    node [fillcolor="#f0f4c3"];
    npk [label="NPK probe (RS485)"];
    usf [label="HC-SR04 front*"];
    gps [label="Neo-6M GPS"];
    env [label="DHT22 / Moisture / TDS / Batt"];
  }
  esp->npk [dir=both, label="MAX485"]; esp->usf [label="25/18"];
  esp->gps [dir=both, label="39 / 15(DGPS)"]; esp->env [label="14/34/36/35"];

  // ---------- LINK ----------
  esp->pi [color="#1565c0", penwidth=2, dir=both, label="UART0 via CP2102\nHMAC-signed"];

  // ---------- RASPBERRY PI ----------
  pi [fillcolor="#c8e6c9", label="Raspberry Pi 4\l\l17<-L enc  27<-R enc\l24<-DS18B20  25<-Float  26<-Rain\l18->WS2812B (DMA, level-shift)\l5/6/12/16<-Buttons  20/21<-Mode\lCE0(8)->LoRa  CE1(7)->SD\lUSB3->Coral  CSI->Camera\lI2C(2/3)->bus\l"];
  pbank->pi [color="#1565c0", penwidth=2, label="5V/3A (separate)"];

  // ---------- I2C BUS ----------
  subgraph cluster_i2c {
    label="I2C BUS (2/3, 4.7k pull-ups)"; color="#f9fbe7"; style=filled;
    node [fillcolor="#f0f4c3"];
    i2c [label="INA219 0x40 | MPU6050 0x68 | VL53L1X 0x29\nOLED 0x3C | PCF8574 0x20 | ADS1115 0x48", shape=record];
  }
  pi->i2c [label="SDA/SCL"];

  // ---------- NEW: current sensing ----------
  ads [fillcolor="#d1c4e9", label="ADS1115 0x48\n(NEW)"];
  acs [fillcolor="#d1c4e9", label="2x ACS712-30A\n(NEW) motor current"];
  acs->ads [label="A0/A1"]; ads->i2c [style=dashed, label="on bus"];

  // ---------- PCF8574 outputs ----------
  pcf [fillcolor="#f8bbd0", label="PCF8574 outputs\nP0 grass | P1 mist | P2 seed | P3/P4 rear US"];
  i2c->pcf [style=dashed];

  // ---------- SPI ----------
  spi [fillcolor="#f0f4c3", label="LoRa SX1276 (CE0) + ant\nSD module (CE1)"];
  pi->spi [label="SPI0 10/9/11"];

  // notes
  note [shape=note, fillcolor="#ffebee", label="SAFETY: Moisture(34)+TDS(36) on 3.3V\nECHO* via 2.2k/3.9k divider\n10k pull-ups on relays 26/13\nFuse+anti-spark in LiPo line\nPi from power bank, not buck"];
}
