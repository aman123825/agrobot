# NOTE: All paths below assume the default deployment layout where the
# repository is cloned to /home/agrobot/agrobot and a virtualenv exists at
# /home/agrobot/agrobot/pi/.venv.  If deploying to a different user or path,
# update WorkingDirectory, EnvironmentFile, and ExecStart accordingly.

[Unit]
Description=AgriRover Orchestrator (main control loop)
After=network-online.target mosquitto.service
Wants=network-online.target
# Field deployment: never stop retrying (docs/UPGRADES.md §10 "Watchdogs").
StartLimitIntervalSec=0

[Service]
Type=simple
User=agrobot
WorkingDirectory=/home/agrobot/agrobot/pi
# /etc/agrirover.env is the canonical secrets home (last file wins).
# Both are optional ("-") so a missing file never blocks boot.
EnvironmentFile=-/home/agrobot/agrobot/pi/.env
EnvironmentFile=-/etc/agrirover.env
ExecStart=/home/agrobot/agrobot/pi/.venv/bin/python /home/agrobot/agrobot/pi/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
