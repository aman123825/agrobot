# NOTE: All paths below assume the default deployment layout where the
# repository is cloned to /home/agrobot/agrobot and a virtualenv exists at
# /home/agrobot/agrobot/pi/.venv.  If deploying to a different user or path,
# update WorkingDirectory, EnvironmentFile, and ExecStart accordingly.

[Unit]
Description=AgriRover Pathway Stream Processor
After=mosquitto.service agrobot-orchestrator.service
Wants=network-online.target

[Service]
Type=simple
User=agrobot
WorkingDirectory=/home/agrobot/agrobot/pi
EnvironmentFile=/home/agrobot/agrobot/pi/.env
ExecStart=/home/agrobot/agrobot/pi/.venv/bin/python /home/agrobot/agrobot/pi/pipeline/pathway_stream.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
